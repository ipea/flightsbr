Type: Package
Package: flightsbr
Title: Download Flight and Airport Data from Brazil
Version: 1.1.10999
Authors@R:
    c(
    person(given="Rafael H. M.", family="Pereira", email="rafa.pereira.br@gmail.com", role=c("aut", "cre"), comment = c(ORCID = "0000-0003-2125-7465")),
